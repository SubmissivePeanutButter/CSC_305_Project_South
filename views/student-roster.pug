extends layout

block content
  // TODO: Display offerings scheduled for Winter 2026; allow new offerings to be
  //    added, as well as for currently scheduled offerings to be canceled
  h1= title
  p #[em [WORK IN PROGRESS]]

  //- a(href="/") Home
  input(type="button", value="Back", onclick="history.back()")
  input(type="button", value="Refresh", onclick="window.location.reload();")
  if students
    if students.length > 0
      table
        caption
          h2 Student Roster
        tr
          each col in Object.keys(students[0])
            th= col
          th Edit Grade
        each row in Object.values(students)
          tr
            each val in row
              if val === null
                td #[em TBD]
              else
                td= val
            td.center-cell
              //- Grade editing has not been implented yet, meaning that 
              //- this input tag is current a placeholder.
              form(action="/submit",method="get")
                input(type="hidden",name="action",value="edit_grade")
                input.textbox(type="text",name="new_grade",placeholder="0.0–4.0",required)
                input(type="hidden",name="ID",value=`${row['StdSSN']}`)
                input(type="hidden",name="role",value=`${formdata.role}`)
                input(type="hidden",name="offerNo",value=`${offering}`)
                input(type="submit",value="Edit",onclick="window.location.reload();")
  else
    p No courses found for this term.