extends layout

block content
  // TODO: Display offerings scheduled for Winter 2026; allow new offerings to be
  //    added, as well as for currently scheduled offerings to be canceled
  h1 Edit Course
  p #[em [WORK IN PROGRESS]]

  a(href="/") Back
  if info
    if info.length > 0
      table
        caption
          h2 Course Info
        tr
          each col in Object.keys(info[0])
            th= col
          th Add Course
        each row in Object.values(info)
          tr
            each val in row
              if val === null
                td #[em TBD]
              else
                td= val
            td.center-cell
              //- Course adding has not been implented yet, meaning that 
              //- this input tag is current a placeholder.
              form(action="",method="get")
                input(type="submit",value="Add")
  else
    p No courses found for this term.