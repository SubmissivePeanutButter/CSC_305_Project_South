extends layout

block content
  // TODO: Display all offerings taught by the current instructor, including the
  //    the course number, term, and year for that offering — also allow a way for 
  //    the instructor to choose one offering (?) and edit grades
  // TODO: When an instructor tries to edit grades, we need to decide whether we'll
  //    show a new page or another table/form
  h1= welcome

  a(href="/") Back
  if invalid_faculty
    h2 No faculty found with ID #{formdata.ID}
  else if courses
    if courses.length > 0
      table
        caption
          h2 Your Courses
        tr
          each col in Object.keys(courses[0])
            th= col
          th Edit Course
        each row in Object.values(courses)
          tr
            each val in row
              if val === null
                td #[em TBD]
              else
                td= val
            td.center-cell
              //- Course cancelation was not been implented yet, meaning that 
              //- these input tags are current placeholders.
              form(action="/edit-course",method="get")
                button(type="submit",name="edit",value=row[0]) Edit
  else
    p No courses found for this instructor.