extends layout

block content
  // TODO: Display all offerings taught by the current instructor, including the
  //    the course number, term, and year for that offering — also allow a way for 
  //    the instructor to choose one offering (?) and edit grades
  // TODO: When an instructor tries to edit grades, we need to decide whether we'll
  //    show a new page or another table/form
  h1= welcome

  //- a(href="/") Home
  input(type="button", value="Home", onclick="window.location.href='/'")
  if invalid_faculty
    h2 No faculty found with ID #{formdata.ID}
  else if courses
    if courses.length > 0
      table
        caption
          h2 Your Courses
        tr
          each col in Object.keys(courses[0])
            th= col
          th Edit Grades
        each row in Object.values(courses)
          tr
            each val in row
              if val === null
                td #[em TBD]
              else
                td= val
            td.center-cell
              form(action="/submit",method="post")
                input(type="hidden",name="ID",value="${formdata.ID}")
                //- input(type="hidden",name="role",value=`${formdata.role}`)
                input(type="hidden",name="offerNo",value=`${row['OfferNo']}`)
                input(type="submit",value="Edit")
  else
    p No courses found for this instructor.

  //- each row in Object.values(courses)
  //-   each val in row
  //-     p= JSON.stringify(row)
  //-     p= row.OfferNo