extends layout

block content
  h1= title
  p Welcome to #{title}
  div(id="form")
    form(action="",method="get")
      if formdata.ID
        input(type="hidden",name="ID",value="${formdata.ID}")
      else
        div(class="form_control")
          label(class="left",for="ID") ID: 
          input(type="text",name="ID",id="ID",required)

      if formdata.role
        input(type="hidden",name="role",value="${formdata.role}")
      else
        div(class="form_control")
          label(class="left",for="role") Role:
          select.dropdown(name="role",id="role",onchange="checkRole(this.value)",required)
            option(value="") Please select a role
            option(value="Student") Student
            option(value="Faculty") Faculty
            option(value="Registrar") Registrar
          output(class="flag")
      input(type="submit")
      script.
        function checkRole(value) {
          const id_field = document.getElementById("ID");
          if (value === "Registrar") {
            id_field.value = 'N/A';
            id_field.readOnly = true;
            return;
          }
          else if (id_field.value === 'N/A') {
            id_field.value = '';
          }
          id_field.readOnly = false;
          return;
        }

  if formdata.role
    table
      caption
        h2 Form data
      tr
        th Key
        th Value
      each value, key in formdata
        tr
          td= key
          td= value
  else
    h2 No form data