extends layout

block content
  // TODO: Display the courses in which the student has already enrolled (all terms)
  // TODO: Display the courses offered in the upcoming term (Winter 2026), including
  //    a way for the stident to enroll in and drop those courses
  h1= welcome
  div(id="form")
    form(action="",method="get")
      input(type="hidden",name="ID",value=`${formdata.ID}`)
      input(type="hidden",name="role",value="Student")
      //input(type="submit")
  a(href="/") Home
  if invalid_student
    h2 No student found with ID #{formdata.ID}
  else if past_enrollments
    if past_enrollments.length > 0
      table
        caption
          h2 Enrolled Courses
        tr
          each col in Object.keys(past_enrollments[0])
            th= col
        each row in Object.values(past_enrollments)
          tr
            each val in row
              if val === null
                td #[em TBD]
              else
                td= val
  else
    h2 No past enrollments found for this student
  if offerings
    if offerings.length > 0
      table
        caption
          h2 Winter 2026 Offerings
        tr
          each col in Object.keys(offerings[0])
            th= col
          th Add/Drop Course
        each row in Object.values(offerings)
          tr
            each val in row
              case val
                when null
                  td #[em TBD]
                when 0
                  td No
                  td.center-cell
                    form(action="",method="get")
                      input(type="hidden",name="action",value="add_course")
                      input(type="hidden",name="ID",value=`${formdata.ID}`)
                      input(type="hidden",name="role",value=`${formdata.role}`)
                      input(type="hidden",name="offerNo",value=`${row['OfferNo']}`)
                      input(type="submit",value="Add")
                when 1
                  td Yes
                  td.center-cell
                    form(action="",method="get")
                      input(type="hidden",name="action",value="drop_course")
                      input(type="hidden",name="ID",value=`${formdata.ID}`)
                      input(type="hidden",name="role",value=`${formdata.role}`)
                      input(type="hidden",name="offerNo",value=`${row['OfferNo']}`)
                      input(type="submit",value="Drop")
                default
                  td= val
            //- td.center-cell
            //-   form(action="",method="get")
            //-     input(type="checkbox")
  else
    p No courses found for Winter 2026.
  //- br
  //- input(type="submit",value="Accept Changes")