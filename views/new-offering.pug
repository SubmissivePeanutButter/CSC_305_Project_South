extends layout

block content
  h1 New Offering
  
  input(type="button",value="Back",onclick="history.back()")
  if courses.length > 0
    table
      caption
        h2 Select a Course
      tr
        each col in Object.keys(courses[0])
          th= col
        th Offering Number
        th Faculty
        th OffLocation
        th OffTime
        th OffDays
        th Add Offering
      each row in Object.values(courses)
        tr
          each val in row
            if val === null
              td #[em TBD]
            else
              td= val
          form(action="/",method="get")
            // Add offering number [REQUIRED]
            td
              input.textbox(type="number",name="offerNo",min=1000,max=9999,required)
            // Select faculty member [OPTIONAL]
            td
              select(name="instructor",required)
                option(value="",selected,disabled) Select a Faculty
                each instructor in instructors
                  option(value=`${instructor.FacSSN}`)= `${instructor.FacFirstName} ${instructor.FacLastName}`
            // Select offering location [OPTIONAL]
            td
              input.textbox(type="text",name="offLocation",required)
            // Select offering time [OPTIONAL]
            td
              input(type="time",name="offTime",step="1",required)
            // Select offering days [OPTIONAL]
            td
              select.textbox(name="offDays",required)
                option(value="",selected,disabled)
                option(value="MW") MW
                option(value="TTH") TTH
            // Form submission
            td.center-cell
              input(type="hidden",name="action",value="add_offering")
              input(type="hidden",name="ID",value=`${formdata.ID}`)
              input(type="hidden",name="role",value=`${formdata.role}`)
              input(type="hidden",name="courseNo",value=`${row['CourseNo']}`)
              input(type="hidden",name="offTerm",value="WINTER")
              input(type="hidden",name="offYear",value=2026)
              input(type="submit",value="Add")
  else
    p No courses found for this term.