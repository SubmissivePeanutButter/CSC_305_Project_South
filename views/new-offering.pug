extends layout

block content
  // TODO: Add functionality for adding a new course offering. In other words, make
  // the 'Add' button work :)
  h1 New Offering
  p #[em [WORK IN PROGRESS]]

  //- a(href="/") Home
  input(type="button", value="Back", onclick="history.back()")
  if courses
    if courses.length > 0
      table
        caption
          h2 Add an Offering
        tr
          each col in Object.keys(courses[0])
            th= col
          th Add Offering
        each row in Object.values(courses)
          tr
            each val in row
              if val === null
                td #[em TBD]
              else
                td= val
            td.center-cell
              // The ability for the registrar to add an offering still needs to be
              // implented, meaning that this input tag is current a placeholder.
              form(action="",method="get")
                input(type="submit",value="Add")
  else
    p No courses found for this term.