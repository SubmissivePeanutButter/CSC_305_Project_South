extends layout

block content
  // TODO: Display offerings scheduled for Winter 2026; allow new offerings to be
  //    added, as well as for currently scheduled offerings to be canceled
  h1= title

  a(href="/") Back
  if offerings
    if offerings.length > 0
      table
        caption
          h2 Winter 2026 Offerings
        tr
          each col in Object.keys(offerings[0])
            th= col
          th Cancel Course
        each row in Object.values(offerings)
          tr
            each val in row
              if val === null
                td #[em TBD]
              else
                td= val
            td
              //- Course cancelation was not been implented yet, meaning that 
              //- these input tags are current placeholders. Thus, you will get
              //- an error if you click "Cancel".
              form(action="",method="get")
                input(type="hidden",name="action",value="cancel_offering")
                input(type="hidden",name="ID",value=`${formdata.ID}`)
                input(type="hidden",name="role",value=`${formdata.role}`)
                input(type="hidden",name="offerings",value=`${row['Flight']}`)
                input(type="hidden",name="role",value="Registrar")
                input(type="submit",value="Cancel")
  else
    p No courses found for this term.
  
