extends layout

block content
  // TODO: Display offerings scheduled for Winter 2026; allow new offerings to be
  //    added, as well as for currently scheduled offerings to be canceled
  h1= title

  a(href="/") Back
  if offerings
    if offerings.length > 0
      table
        caption
          h2 Winter 2026 Offerings
        tr
          each col in Object.keys(offerings[0])
            th= col
          th Cancel Course
        each row in Object.values(offerings)
          tr
            each val in row
              if val === null
                td #[em TBD]
              else
                td= val
            td.center-cell
              //- Course cancelation was not been implented yet, meaning that 
              //- these input tags are current placeholders.
              form(action="",method="get")
                input(type="submit",value="Cancel")
  else
    p No courses found for this term.