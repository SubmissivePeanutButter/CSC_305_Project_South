extends layout

block content
  // Currently, no data is being fed to edit-offering, which is why all of the
  // values will show up as 'N/A'. Also, I used a table simply because I copied
  // much of the code from the Registrar page.
  h1 Edit Offering
  p #[em [WORK IN PROGRESS]]

  input(type="button",value="Cancel",onclick="history.back()")
  if offerings.length > 0
    table
      caption
        h2 Selected Offering
      tr
        each col in Object.keys(offerings[0])
          th= col
        th Submit
      tr
        each val in Object.keys(offerings[0])
          if val === null
            td #[em TBD]
          else
            td N/A
        td.center-cell
          //- Offering editing still needs to be implemented, meaning that 
          //- these input tags are current placeholders.
          form(action="/",method="get")
            input(type="hidden",name="action",value="edit_offering")
            input(type="hidden",name="ID",value=`${formdata.ID}`)
            input(type="hidden",name="role",value=`${formdata.role}`)
            // Line 30's value is a placeholder, so please change it at some point
            input(type="hidden",name="offerNo",value=`${Object.keys(offerings[0])['OfferNo']}`)
            input(type="submit",value="Submit")
  else
    p #[em No courses could be found.]