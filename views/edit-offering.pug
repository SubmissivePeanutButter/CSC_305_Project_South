extends layout

block content
  h1 Edit Offering

  input(type="button",value="Cancel",onclick="history.back()")
  if offering
    table
      caption
        h2 Selected Offering
      tr
        each col in Object.keys(offering)
          if col != 'FacSSN'
            th= col
          else
            th Faculty
        th Submit Changes
      tr
        form(action="/",method="get")
          // Offering name, course number, and course name
          td= offering.OfferNo
            input(name="offerNo",type="hidden",value=`${offering.OfferNo}`)
          td= offering.CourseNo
          td= offering.CrsDesc
          // Offering location [EDITABLE]
          td
            input.textbox(name="offLocation",type="text",value=`${offering.OffLocation}`,required)
          // Offering time [EDITABLE]
          td
            input(name="offTime",type="time",value=`${offering.OffTime}`,step=1,required)
          // Offering faculty [EDITABLE]
          td
            // An issue with this approach is that, if no faculty is set for a
            // course, it automatically fills in the first possible value from the
            // list, which is Cristopher Colan. However, new-offering is currently
            // set up to where a faculty member MUST be selected, so I don't think
            // this would be a major problem in the long run.
            select(name="instructor",required)
              each instructor in instructors
                if instructor.FacSSN != offering.FacSSN
                  option(value=`${instructor.FacSSN}`)= `${instructor.FacFirstName} ${instructor.FacLastName}`
                else
                  option(value=`${instructor.FacSSN}`,selected)= `${instructor.FacFirstName} ${instructor.FacLastName}`
          // Offering days [EDITABLE]
          td
            select.textbox(name="offDays",required)
              if offering.OffDays == 'MW'
                option(value="MW",selected) MW
                option(value="TTH") TTH
              else
                option(value="MW") MW
                option(value="TTH",selected) TTH
          // Submit changes
          td.center-cell
            form(action="/",method="get")
              input(type="hidden",name="action",value="edit_offering")
              input(type="hidden",name="ID",value=`${formdata.ID}`)
              input(type="hidden",name="role",value=`${formdata.role}`)
              input(type="submit",value="Submit")
  else
    p #[em No courses could be found.]